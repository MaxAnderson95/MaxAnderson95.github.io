---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { formatDate, getVisiblePosts, slugifyTag } from "../../lib/utils";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const posts = getVisiblePosts(allPosts);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} · Max Anderson`}
  description={post.data.excerpt}
  image={post.data.featureImage}
>
  <Navbar active="blog" />

  <main id="main-content" tabindex="-1" class="wrap flex-1">
    <article class="post">
      <header class="post__head">
        <h1 class="post__title">{post.data.title}</h1>
      </header>

      <aside class="post__aside" aria-label="About this post">
        <a href="/blog/" class="back-link quiet-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
          </svg>
          Back to all posts
        </a>

        <dl class="post__facts">
          <div>
            <dt>Published</dt>
            <dd><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></dd>
          </div>
          <div>
            <dt>Length</dt>
            <dd>{post.data.readTime}</dd>
          </div>
          <div>
            <dt>Tags</dt>
            <dd>
              <ul role="list" class="tag-list">
                {post.data.tags.map((tag: string) => (
                  <li><a class="quiet-link" href={`/tags/${slugifyTag(tag)}/`}>{tag}</a></li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </aside>

      {post.data.featureImage && (
        <figure class="post__figure cut">
          <img
            src={post.data.featureImage}
            alt={post.data.featureImageAlt || `Feature image for ${post.data.title}`}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )}

      <div class="post__body prose">
        <Content />
      </div>

      <footer class="post__foot">
        <a href="/blog/" class="back-link quiet-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
          </svg>
          Back to all posts
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import AsciiField from "../components/AsciiField.astro";
import Hero from "../components/Hero";
import RoleTyper from "../components/RoleTyper.astro";
import { siteData } from "../data/site";
---

<BaseLayout>
  <Navbar active="home" />

  <main id="main-content" tabindex="-1" class="home flex-1">
    <section class="hero" aria-label="Introduction">
      <AsciiField rawAfter=".hero__column" />
      <div class="wrap hero__grid">
        <Hero name={siteData.name} bio={siteData.bio} emailUrl={siteData.socials.email.url}>
          <RoleTyper roles={["Senior Platform Engineer", "Cloud-Native Engineer", "Infrastructure Engineer"]} />
        </Hero>
      </div>
    </section>
  </main>
</BaseLayout>

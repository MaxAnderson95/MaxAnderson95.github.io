---
import { siteData } from "../data/site";

interface Props {
  active?: "home" | "blog" | "certifications" | "work-history";
}

const { active = "home" } = Astro.props;
---

<header class="site-nav">
  <nav aria-label="Main" class="wrap site-nav__inner">
    <a href="/" class="site-nav__mark" aria-current={active === "home" ? "page" : undefined}>
      Max Anderson
    </a>

    <ul role="list" class="site-nav__links">
      <li>
        <a href="/blog/" class="site-nav__link" aria-current={active === "blog" ? "page" : undefined}>Blog</a>
      </li>
      <li>
        <a href="/work-history/" class="site-nav__link" aria-current={active === "work-history" ? "page" : undefined}>Work</a>
      </li>
      <li>
        <a href="/certifications/" class="site-nav__link" aria-current={active === "certifications" ? "page" : undefined}>Certs</a>
      </li>
    </ul>

    <ul role="list" class="site-nav__social">
      <li>
        <a
          href={siteData.socials.github.url}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-link"
          aria-label="GitHub (opens in new tab)"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>
      </li>
      <li>
        <a
          href={siteData.socials.linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-link"
          aria-label="LinkedIn (opens in new tab)"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
            <rect width="4" height="12" x="2" y="9" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </a>
      </li>
    </ul>

    <a href={siteData.socials.email.url} class="key key--small" data-email-menu>Email me</a>
  </nav>
</header>

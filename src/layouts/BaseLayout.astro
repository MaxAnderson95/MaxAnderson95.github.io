---
import EmailMenu from "../components/EmailMenu.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Max Anderson · Senior Engineer",
  description = "Senior engineer's notes on Kubernetes, Azure, and cloud-native infrastructure.",
  image,
} = Astro.props;

const googleFontUrl =
  "https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap";

const siteUrl = Astro.site ?? new URL("https://maxanderson.tech");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = image ? new URL(image, siteUrl).toString() : undefined;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}

    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={googleFontUrl} rel="stylesheet" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="flex flex-col min-h-svh">
      <slot />
    </div>
    <EmailMenu />
    <script is:inline>
      // Inline at the end of the body so the hidden state is set before the
      // first paint, and only together with the observer that reveals it.
      (() => {
        const items = document.querySelectorAll("[data-reveal] > *");
        if (!items.length || !("IntersectionObserver" in window)) return;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.documentElement.classList.add("reveal-ready");
        const observer = new IntersectionObserver(
          (entries) => {
            let n = 0;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.style.setProperty("--reveal-delay", `${n++ * 80}ms`);
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.05 }
        );
        items.forEach((item) => observer.observe(item));
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
